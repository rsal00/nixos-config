configuration{
    modi: "drun";
    icon-theme: "Numix-Circle";
    font: "JetBrains Mono Regular 13";
    show-icons: true;
    terminal: "wezterm";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps ";
    sidebar-mode: true;
    border-radius: 10;
}

//@theme "~/.config/rofi/themes/catppuccin-macchiato.rasi"

@theme "/nix/store/yb2z62w6i6rsvn3anzxl1rlhaq026ayr-rofi-2.0.0/share/rofi/themes/DarkBlue.rasi"
